@model CVApp.Models.CVModel

<!-- Bootstrap, Google Fonts ve Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f4f6f8;
    }
    .cv-container {
        max-width: 900px;
        margin: auto;
        background-color: white;
        display: flex;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .cv-left {
        width: 30%;
        background-color: #2c3e50;
        color: white;
        padding: 30px;
    }
    .cv-right {
        width: 70%;
        padding: 30px;
    }
    .section-title {
        border-bottom: 1px solid #ccc;
        margin-top: 20px;
        margin-bottom: 10px;
        padding-bottom: 5px;
        font-weight: bold;
    }
</style>

<div class="cv-container mt-5 rounded">
    <!-- Sol Profil Alanı -->
    <div class="cv-left">
        <h2 class="mb-4">@Model.FullName</h2>
        <div class="mb-4">
            <i class="bi bi-envelope-fill"></i>
            <p class="mb-2">@Model.Email</p>
            <i class="bi bi-telephone-fill"></i>
            <p>@Model.Phone</p>
        </div>
        <hr class="border-light" />
        <div class="mt-4">
            <h5 class="mb-3">Yetenekler</h5>
            <ul class="list-unstyled">
                @foreach (var skill in Model.Skills)
                {
                    <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>@skill</li>
                }
            </ul>
        </div>
    </div>

    <!-- Sağ İçerik Alanı -->
    <div class="cv-right">
        <h4 class="section-title">Hakkımda</h4>
        <p>@Model.Summary</p>

        <h4 class="section-title">Eğitim</h4>
        <ul class="list-group mb-3">
            @foreach (var edu in Model.Education)
            {
                <li class="list-group-item">@edu</li>
            }
        </ul>

        <h4 class="section-title">Deneyim</h4>
        <ul class="list-group">
            @foreach (var exp in Model.Experience)
            {
                <li class="list-group-item">@exp</li>
            }
        </ul>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
